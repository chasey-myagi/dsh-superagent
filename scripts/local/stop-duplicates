#!/usr/bin/env python3
"""stop-duplicates: stop open orchestrator tickets superseded by a merged PR.

The operator merges a PR (often through ``land-me`` -> ``ghpr``), but a
dogfood ticket for the same topic may still be open and working.  Running
this script after the merge stops those tickets before they repeat the work:

    scripts/local/stop-duplicates --title "D16: recall 默认 limit"
    scripts/local/stop-duplicates --issue 20 21 --reason "merged in #13"
    scripts/local/stop-duplicates --title "D16 ..." --dry-run

Matching uses the open-ticket list from the orchestrator management API:

* every issue number given by ``--issue`` that appears among the ticket's
  GitHub thread facts (or ``mandate.basis.scope.number`` /
  ``channels[].address.number`` when the API exposes them);
* token overlap between ``--title`` and the ticket title, using Jaccard >= 0.4
  after stop-word removal, or a shared code-like key token (``D16``,
  ``parse_since``, ...).

For every match it calls ``POST tickets/<id>/stop`` and, when the ticket has
an issue number, leaves a short ``gh-local comment <issue>``.  ``--dry-run``
only prints what would be stopped.  The merge itself never depends on this
script: a failure here is reported but does not undo the merge.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import unicodedata
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_BASE = os.environ.get("DSH_ORCHESTRATOR_API", "http://127.0.0.1:3082/orchestrator/api")
REQUEST_HEADER = {"x-orchestrator-request": "1", "Accept": "application/json"}
TIMEOUT = 10

# Very common words that make unrelated Chinese/English task titles look
# similar; the stop list only removes noise, it does not need to be complete.
STOPWORDS = {
    "the", "a", "an", "and", "or", "of", "to", "in", "on", "for", "with", "by",
    "from", "is", "are", "be", "as", "at", "this", "that", "it", "not", "do",
    "does", "did", "but", "if", "then", "so", "than", "into", "via", "use",
    "using", "add", "new", "fix", "update", "support", "test", "tests",
    "的", "了", "和", "与", "及", "或", "在", "是", "有", "为", "对", "把",
    "被", "从", "到", "中", "上", "下", "后", "前", "并", "也", "都", "就",
    "而", "且", "请", "需要", "一个", "这个",
}

ASCII_TOKEN = re.compile(r"[a-z0-9][a-z0-9_+#.-]*")
CJK_RUN = re.compile(r"[\u3400-\u9fff]+")
ISSUE_NUMBER = re.compile(r"#?(\d+)")


def log(message: str) -> None:
    print(message, file=sys.stderr)


def title_tokens(title: str) -> set[str]:
    """Tokenize a title into lowercase ASCII terms and CJK bigrams."""
    normalized = unicodedata.normalize("NFKC", title or "").lower()
    tokens: set[str] = set()
    for match in ASCII_TOKEN.finditer(normalized):
        token = match.group(0).strip("._#+-")
        if not token or token in STOPWORDS:
            continue
        # Bare two-digit numbers are usually issue references, not topic words.
        if token.isdigit() and len(token) < 3:
            continue
        tokens.add(token)
    for match in CJK_RUN.finditer(normalized):
        run = match.group(0)
        if len(run) == 1:
            if run not in STOPWORDS:
                tokens.add(run)
            continue
        for index in range(len(run) - 1):
            bigram = run[index:index + 2]
            if bigram not in STOPWORDS:
                tokens.add(bigram)
    return tokens


def code_tokens(tokens: set[str]) -> set[str]:
    """Distinctive identifiers such as D16, D17, parse_since, or v2_api."""
    return {
        token for token in tokens
        if token.isascii()
        and (
            ("_" in token and len(token) >= 4)
            or (
                any(char.isdigit() for char in token)
                and any(char.isalpha() for char in token)
                and len(token) >= 3
            )
        )
    }


def title_matches(left: str, right: str, threshold: float = 0.4) -> bool:
    a = title_tokens(left)
    b = title_tokens(right)
    if not a or not b:
        return False
    shared = a & b
    if not shared:
        return False
    if len(shared) / len(a | b) >= threshold:
        return True
    return bool(code_tokens(shared))


def add_number(numbers: set[int], value: object) -> None:
    if value is None or isinstance(value, bool):
        return
    if isinstance(value, int):
        numbers.add(value)
        return
    if isinstance(value, float) and value.is_integer():
        numbers.add(int(value))
        return
    if isinstance(value, str):
        match = ISSUE_NUMBER.fullmatch(value.strip())
        if match:
            numbers.add(int(match.group(1)))
        return
    if isinstance(value, dict):
        for key in ("number", "issue", "value"):
            if key in value:
                add_number(numbers, value[key])
        return
    if isinstance(value, list):
        for item in value:
            add_number(numbers, item)


def ticket_issues(ticket: dict) -> set[int]:
    """Issue numbers attached to a ticket through its mandate, channels or threads."""
    numbers: set[int] = set()
    mandate = ticket.get("mandate")
    if isinstance(mandate, dict):
        scope = mandate.get("scope")
        if isinstance(scope, dict):
            add_number(numbers, scope.get("number"))
        else:
            add_number(numbers, scope)
        basis = mandate.get("basis")
        if isinstance(basis, dict):
            basis_scope = basis.get("scope")
            if isinstance(basis_scope, dict):
                add_number(numbers, basis_scope.get("number"))
    for channel in ticket.get("channels") or []:
        if isinstance(channel, dict):
            address = channel.get("address")
            if isinstance(address, dict):
                add_number(numbers, address.get("number"))
    # The current ticket list view exposes GitHub issue numbers as thread
    # facts ({"number": {"value": "#20"}}) rather than mandate/channel fields.
    for thread in ticket.get("threads") or []:
        if not isinstance(thread, dict):
            continue
        facts = thread.get("facts")
        if isinstance(facts, dict) and "number" in facts:
            add_number(numbers, facts["number"])
    return numbers


def matches(ticket: dict, issues: set[int], title: str | None) -> bool:
    if issues and ticket_issues(ticket) & issues:
        return True
    return bool(title and title_matches(title, str(ticket.get("title") or "")))


def request_json(base: str, path: str, method: str = "GET") -> object:
    url = base.rstrip("/") + "/" + path.lstrip("/")
    headers = dict(REQUEST_HEADER)
    data = None
    if method == "POST":
        data = b"{}"
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            body = response.read().decode("utf-8")
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", "replace").strip()
        raise RuntimeError(f"{method} {url} failed: HTTP {error.code} {detail}") from error
    except urllib.error.URLError as error:
        raise RuntimeError(f"{method} {url} failed: {error.reason}") from error
    if not body.strip():
        return {}
    try:
        return json.loads(body)
    except json.JSONDecodeError as error:
        raise RuntimeError(f"{method} {url} returned invalid JSON: {error}") from error


def open_tickets(base: str) -> list[dict]:
    tickets: list[dict] = []
    offset = 0
    while True:
        query = urllib.parse.urlencode({"state": "open", "offset": offset})
        payload = request_json(base, f"tickets?{query}")
        if isinstance(payload, list):
            items, next_offset = payload, None
        elif isinstance(payload, dict):
            items = payload.get("items", [])
            next_offset = payload.get("next_offset")
        else:
            raise RuntimeError("tickets endpoint returned an unexpected payload")
        if not isinstance(items, list):
            raise RuntimeError("tickets endpoint returned no items list")
        tickets.extend(item for item in items if isinstance(item, dict))
        if not next_offset:
            return tickets
        offset = int(next_offset)
        if len(tickets) > 5000:
            raise RuntimeError("refusing to follow more than 5000 tickets")


def stop_ticket(base: str, ticket_id: str) -> None:
    quoted = urllib.parse.quote(ticket_id, safe="")
    request_json(base, f"tickets/{quoted}/stop", method="POST")


def comment_issue(issue: int, body: str) -> None:
    executable = shutil.which("gh-local") or os.path.expanduser("~/.local/bin/gh-local")
    if not (executable and os.path.isfile(executable) and os.access(executable, os.X_OK)):
        log(f"warning: gh-local not found; issue #{issue} was not commented")
        return
    try:
        result = subprocess.run(
            [executable, "comment", str(issue), body],
            capture_output=True, text=True, timeout=30,
        )
    except (OSError, subprocess.SubprocessError) as error:
        log(f"warning: gh-local comment on #{issue} failed: {error}")
        return
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        log(f"warning: gh-local comment on #{issue} failed: {detail}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Stop open orchestrator tickets for a topic already merged.",
        epilog=(
            "Matching: --issue matches GitHub issue numbers; --title matches "
            "after stop-word removal by Jaccard >= 0.4 or a shared identifier "
            "token such as D16/parse_since. Dry-run never posts."
        ),
    )
    parser.add_argument("--title", help="merged PR title to match against open ticket titles")
    parser.add_argument("--issue", nargs="+", type=int, metavar="N",
                        help="issue number(s) the merged PR supersedes")
    parser.add_argument("--reason", default="PR merged",
                        help="text used in the stop and issue comment (default: %(default)s)")
    parser.add_argument("--dry-run", action="store_true",
                        help="print what would be stopped, without POSTing or commenting")
    parser.add_argument("--base-url", default=DEFAULT_BASE,
                        help="orchestrator management API base (default: %(default)s)")
    args = parser.parse_args(argv)

    if not args.title and not args.issue:
        parser.error("at least one of --title or --issue is required")

    base = args.base_url
    issues = set(args.issue or [])
    try:
        tickets = open_tickets(base)
    except RuntimeError as error:
        log(f"stop-duplicates: {error}")
        return 2

    selected = [
        ticket for ticket in tickets
        if (not ticket.get("state") or ticket.get("state") == "open")
        and matches(ticket, issues, args.title)
    ]

    if not selected:
        print("stop-duplicates: no matching open tickets")
        return 0

    comment_body = f"已由合并取代：{args.reason}；已 stop 工单"
    failures = 0
    commented: set[int] = set()
    for ticket in sorted(selected, key=lambda item: str(item.get("id", ""))):
        ticket_id = str(ticket.get("id") or "")
        title = str(ticket.get("title") or "")
        ticket_numbers = sorted(ticket_issues(ticket))
        suffix = f"  (issue #{', #'.join(map(str, ticket_numbers))})" if ticket_numbers else ""
        if args.dry_run:
            print(f"[dry-run] would stop {ticket_id}  {title}{suffix}")
            continue
        if not ticket_id:
            log("warning: matched a ticket without an id; skipped")
            failures += 1
            continue
        try:
            stop_ticket(base, ticket_id)
        except RuntimeError as error:
            log(f"warning: could not stop {ticket_id}: {error}")
            failures += 1
            continue
        print(f"stopped {ticket_id}  {title}{suffix}")
        for number in ticket_numbers:
            if number in commented:
                continue
            commented.add(number)
            comment_issue(number, f"{comment_body} {ticket_id}")

    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())